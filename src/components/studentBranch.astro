const UOTTAWA = [
    {
        title: "Chair",
        name: "Stuti Pandya",
    },
    {
        title: "Vice Chair",
        name: "Chloe Dupont",
    },
    {
        title: "External",
        name: "Pavithra Raj Mohan",
    },

    {
